{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_FEATURES": "binaryninja;tests"
      }
    },
    {
      "name": "binja-vcpkg",
      "description": "Build for Binary Ninja with vcpkg dependencies",
      "inherits": ["vcpkg"],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/install",
        "BINEXPORT_ENABLE_IDAPRO": false,
        "BINEXPORT_ENABLE_BINARYNINJA": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "ci-vcpkg",
      "environment": {
        "VCPKG_ROOT": "$env{VCPKG_INSTALLATION_ROOT}"
      },
      "cacheVariables": {
        "VCPKG_INSTALL_OPTIONS": "--debug"
      }
    },
    {
      "name": "ci-multi-config",
      "description": "Speed up multi-config generators by generating only one configuration instead of the defaults",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo"
      }
    },
    {
      "name": "ci-ubuntu-vcpkg",
      "inherits": ["ci-vcpkg", "binja-vcpkg"],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-release"
      },
      "environment": {
        "VCPKG_DEFAULT_HOST_TRIPLET": "x64-linux-release"
      }
    },
    {
      "name": "ci-macos-vcpkg",
      "generator": "Xcode",
      "inherits": ["ci-vcpkg", "binja-vcpkg", "ci-multi-config"],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "universal-macos-release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_XCODE_ATTRIBUTE_OTHER_CODE_SIGN_FLAGS": "-o linker-signed",
        "CMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST"
      },
      "environment": {
        "VCPKG_DEFAULT_HOST_TRIPLET": "universal-macos-release"
      }
    },
    {
      "name": "ci-windows-vcpkg",
      "inherits": ["ci-vcpkg", "binja-vcpkg"],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release"
      },
      "environment": {
        "VCPKG_DEFAULT_HOST_TRIPLET": "x64-windows-static-md-release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "binja-vcpkg",
      "configurePreset": "binja-vcpkg"
    },
    {
      "name": "ci-common-config",
      "hidden": true,
      "configuration": "RelWithDebInfo",
      "jobs": 4
    },
    {
      "name": "ci-ubuntu-vcpkg",
      "configurePreset": "ci-ubuntu-vcpkg",
      "inherits": ["ci-common-config"]
    },
    {
      "name": "ci-macos-vcpkg",
      "configurePreset": "ci-macos-vcpkg",
      "inherits": ["ci-common-config"]
    },
    {
      "name": "ci-windows-vcpkg",
      "configurePreset": "ci-windows-vcpkg",
      "inherits": ["ci-common-config"]
    }
  ],
  "testPresets": [
    {
      "name": "binja-vcpkg",
      "configurePreset": "binja-vcpkg"
    },
    {
      "name": "ci-common-config",
      "hidden": true,
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-ubuntu-vcpkg",
      "configurePreset": "ci-ubuntu-vcpkg",
      "inherits": ["ci-common-config"]
    },
    {
      "name": "ci-macos-vcpkg",
      "configurePreset": "ci-macos-vcpkg",
      "inherits": ["ci-common-config"]
    },
    {
      "name": "ci-windows-vcpkg",
      "configurePreset": "ci-windows-vcpkg",
      "inherits": ["ci-common-config"]
    }
  ]
}
